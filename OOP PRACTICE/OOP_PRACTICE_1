import random
class Player:
    def __init__(self,name):
        self.name = name
        self.health = 100
        self.level = 1
        self.heal_cd_value = 0
        self.heal_cd_status = False

    def __str__(self):
        return self.name

    def attack(self):
        damage = random.randint(1,10)
        return damage

    def heal_cooldown(self):
        if self.heal_cd_value > 0:
            self.heal_cd_status = True
            return False
        else:
            self.heal_cd_status = False
            return True

    def heal_cap(self):
        if self.health >= 100:
            #print("Heal cap 1")
            return False
        elif 0 < self.health < 100:
            #print("Heal cap 2")
            return True
        else:
            #print("Heal cap 4")
            return None
        
    def heal_validation(self):
        heal_cap_result = self.heal_cap()
        heal_cooldown_result = self.heal_cooldown()
        if heal_cooldown_result:
            if heal_cap_result is None:
                #print("Error Negative health validation.")
                return None
            elif not heal_cap_result:
                #print("Heal validation 1")
                return False
            else:
                #print("Heal validation 2")
                return True
        else:
            return False

        
    def heal(self):
        heal_validation_result = self.heal_validation()

        if heal_validation_result:
            if self.health + 10 > 100:
                self.health = 100
                self.heal_cd_value = 3
                #print("Heal 1")
                
            else:
                self.health += 10
                self.heal_cd_value = 3
                #print("Heal 2")
                print(f"{self.name} restores 10 healths")
            return self.health
        
        elif heal_validation_result == None:
            print("Error Negative health execution")
        elif self.heal_cd_status:
            print("Heal skill is on Cooldown!")
        else:
            print("Your health is full!")
        return self.health
    
    def take_damage(self,damage):
        self.health -= damage
        return self.health
    def show_status(self):
        print(f"""
        Name: {self.name}
        Health: {self.health}
        Level: {self.level}
        Heal Cooldown : {self.heal_cd_value}
        """)

    def remaining_universal_cooldown(self):
        if self.heal_cd_value > 0:
            self.heal_cd_value -= 1

    def is_dead(self):
        if self.health <= 0:
            self.health = 0
            return True
        return False

